  "views": [
    {
      "bindings": [
        {
          "id": "preferences",
          "settingsKey": "vaultAi.preferences",
          "source": "settings"
        },
        {
          "capability": "ai.generate",
          "id": "provider",
          "source": "capability"
        }
      ],
      "id": "settings",
      "kind": "settings",
      "root": {
        "accessibility": {
          "label": "Vault AI settings",
          "role": "form"
        },
        "children": [
          {
            "binding": "provider",
            "text": "AI provider status",
            "type": "metadata"
          },
          {
            "binding": "preferences",
            "field": {
              "id": "concise",
              "label": "Prefer concise responses",
              "type": "boolean"
            },
            "type": "field"
          },
          {
            "binding": "preferences",
            "field": {
              "id": "includeSources",
              "label": "Include source references when available",
              "type": "boolean"
            },
            "type": "field"
          },
          {
            "action": "saveAiSettings",
            "text": "Save AI preferences",
            "type": "button"
          }
        ],
        "type": "section"
      },
      "states": {
        "capabilityUnavailable": {
          "accessibility": {
            "role": "status"
          },
          "text": "No AI provider is configured. Vault AI will not generate or simulate output.",
          "type": "errorState"
        },
        "error": {
          "accessibility": {
            "role": "status"
          },
          "text": "Vault AI settings are unavailable",
          "type": "errorState"
        }
      },
      "title": "Vault AI settings"
    }
  ]
