  "id": "digital.modula.vault-notes.ai",
  "slug": "vault-ai",
  "name": "Vault AI",
  "description": "Provider-neutral governed AI add-on for Vault Notes with scoped, user-triggered actions.",
  "publisher": {
    "id": "modula",
    "name": "Modula",
    "website": "https://modula.digital",
    "supportUrl": "https://modula.digital/support"
  },
  "compatibility": {
    "host": "^1.0.0",
    "runtime": "^1.0.0",
    "standard": "^2.1.0",
    "platforms": [
      "ios",
      "android",
      "web",
      "server"
    ]
  },
  "lifecycle": {
    "executionMode": "declarative",
    "defaultState": "installed",
    "allowedTransitions": [
      {
        "from": "discovered",
        "to": "installed",
        "auditEvent": "module.installed"
      },
      {
        "from": "installed",
        "to": "enabled",
        "requiresConfirmation": true,
        "auditEvent": "module.enabled"
      },
      {
        "from": "enabled",
        "to": "disabled",
        "auditEvent": "module.disabled"
      },
      {
        "from": "disabled",
        "to": "enabled",
        "requiresConfirmation": true,
        "auditEvent": "module.enabled"
      },
      {
        "from": "enabled",
        "to": "updating",
        "auditEvent": "module.update-started"
      },
      {
        "from": "updating",
        "to": "enabled",
        "auditEvent": "module.updated"
      },
      {
        "from": "updating",
        "to": "failed",
        "auditEvent": "module.update-failed"
      },
      {
        "from": "enabled",
        "to": "quarantined",
        "auditEvent": "module.quarantined"
      },
      {
        "from": "failed",
        "to": "disabled",
        "auditEvent": "module.disabled"
      },
      {
        "from": "disabled",
        "to": "uninstalled",
        "requiresConfirmation": true,
        "auditEvent": "module.uninstalled"
      }
    ],
    "uninstall": {
      "dataPolicy": "retain",
      "requiresConfirmation": true
    }
  },
  "permissions": [
    {
      "id": "notes.read",
      "reason": "Read only the user-selected note for an invoked AI action.",
      "risk": "low",
      "required": true,
      "policyMode": "observe"
    },
    {
      "id": "notes.search",
      "reason": "Search Vault Notes only when the user requests AI-assisted search.",
      "risk": "medium",
      "required": true,
      "policyMode": "observe"
    },
    {
      "id": "notes.update",
      "reason": "Apply a reviewed AI result to the selected note.",
      "risk": "medium",
      "required": true,
      "policyMode": "observe"
    },
    {
      "id": "notes.editor.contribute",
      "reason": "Register declared AI editor commands.",
      "risk": "low",
      "required": true,
      "policyMode": "observe"
    },
    {
      "id": "notes.actions.contribute",
      "reason": "Register declared note actions.",
      "risk": "low",
      "required": true,
      "policyMode": "observe"
    },
    {
      "id": "notes.events.subscribe",
      "reason": "Subscribe to versioned Vault Notes events after approval.",
      "risk": "medium",
      "required": true,
      "policyMode": "observe"
    },
    {
      "id": "ai.request",
      "reason": "Invoke a configured real AI provider through Greenfield.",
      "risk": "medium",
      "required": true,
      "policyMode": "observe"
    },
    {
      "id": "ai.context.private",
      "reason": "Use the explicitly selected private note as bounded context.",
      "risk": "high",
      "required": true,
      "policyMode": "require-confirmation"
    },
    {
      "id": "ai.structured-output",
      "reason": "Validate structured AI results before returning them.",
      "risk": "medium",
      "required": true,
      "policyMode": "observe"
    }
  ],
  "capabilities": [
    {
      "id": "ai",
      "required": true,
      "reason": "Execute provider-neutral AI actions through Greenfield."
    },
    {
      "id": "functions",
      "required": true,
      "reason": "Expose reusable headless Vault AI functions."
    },
    {
      "id": "services",
      "required": true,
      "reason": "Use a Greenfield-scoped extension service binding."
    },
    {
      "id": "ui-contributions",
      "required": true,
      "reason": "Publish declarative Vault Notes actions and commands."
    },
    {
      "id": "jobs",
      "required": true,
      "reason": "Run bounded asynchronous AI work."
    },
    {
      "id": "events",
      "required": true,
      "reason": "Subscribe to declared Vault Notes events when granted."
    },
    {
      "id": "automations",
      "required": true,
      "reason": "Expose approved headless functions to governed automations."
    }
  ],
